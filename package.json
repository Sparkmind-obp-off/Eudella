{
  "name": "eudella",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EUDELLA \u2014 Support for the life you're living. Powered by ALSOS.",
  "license": "UNLICENSED",
  "scripts": {
    "dev:web": "vite",
    "dev": "npm run build && wrangler dev --local --port 8787",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply eudella-db --local",
    "db:seed:local": "wrangler d1 execute eudella-db --local --file=seed/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply eudella-db --remote",
    "db:seed:remote": "wrangler d1 execute eudella-db --remote --file=seed/seed.sql",
    "deploy": "npm run build && wrangler deploy",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:licenses": "node scripts/license-report.mjs",
    "check:all": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:secrets && npm run check:licenses",
    "test:e2e": "wrangler d1 execute eudella-db --local --command \"DELETE FROM rate_limits\" >/dev/null && node e2e/journeys.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "hono": "^4.13.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
